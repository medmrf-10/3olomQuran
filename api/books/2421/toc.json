{"id": 2421, "slug": "ياقوتة-الصراط-في-تفسير-غريب-القرآن", "title": "ياقوتة الصراط في تفسير غريب القرآن", "author": "أبو عمر الزاهد المطرز غلام ثعلب", "death": "345", "toc": [{"i": 0, "t": "﷽", "d": 0, "pg": 1}, {"i": 1, "t": "وبه أستعين", "d": 0, "pg": 1}, {"i": 2, "t": "فاتحة الكتاب", "d": 0, "pg": 3}, {"i": 3, "t": "ومن سورة البقرة", "d": 0, "pg": 5}, {"i": 4, "t": "ومن سورة آل عمران", "d": 0, "pg": 21}, {"i": 5, "t": "ومن سورة النساء", "d": 0, "pg": 31}, {"i": 6, "t": "ومن سورة المائدة", "d": 0, "pg": 43}, {"i": 7, "t": "ومن سورة الأنعام", "d": 0, "pg": 53}, {"i": 8, "t": "ومن سورة الأعراف", "d": 0, "pg": 63}, {"i": 9, "t": "ومن سورة الأنفال", "d": 0, "pg": 71}, {"i": 10, "t": "ومن سورة براءة", "d": 0, "pg": 77}, {"i": 11, "t": "إلا ولا ذمة فالإل الله ﷿ والذمة العهد وليجة الوليجة الرجل يدخل على المؤمنين فيقول أنا منكم ويدخل على المنافقين ويقول أنا منكم ويدخل على اليهود فيسهل عليهم أمر اليهودية وجمعه ولائج", "d": 0, "pg": 77}, {"i": 12, "t": "ومن سورة يونس عليه السلام", "d": 0, "pg": 87}, {"i": 13, "t": "ومن سورة هود عليه السلام", "d": 0, "pg": 97}, {"i": 14, "t": "ومن سورة يوسف عليه السلام", "d": 0, "pg": 109}, {"i": 15, "t": "ومن سورة الرعد", "d": 0, "pg": 115}, {"i": 16, "t": "ومن سورة إبراهيم عليه السلام", "d": 0, "pg": 121}, {"i": 17, "t": "ومن سورة الحجر", "d": 0, "pg": 125}, {"i": 18, "t": "ب ومن سورة النحل", "d": 0, "pg": 129}, {"i": 19, "t": "ومن سورة بني إسرائيل", "d": 0, "pg": 141}, {"i": 20, "t": "وليتبروا أي وليدمروا أي وليهلكوا تتبيرا أي إهلاكا وتدميرا والعرب تقول تبرته ودمرته وأهلكته بمعنى واحد حصيرا أي حبيسا", "d": 0, "pg": 141}, {"i": 21, "t": "ومن سورة الكهف", "d": 0, "pg": 153}, {"i": 22, "t": "ومن سورة مريم عليها السلام", "d": 0, "pg": 169}, {"i": 23, "t": "ومن سورة طه", "d": 0, "pg": 181}, {"i": 24, "t": "ومن سورة الأنبياء عليهم السلام", "d": 0, "pg": 193}, {"i": 25, "t": "ومن سورة الحج", "d": 0, "pg": 203}, {"i": 26, "t": "ومن سورة المؤمنين", "d": 0, "pg": 209}, {"i": 27, "t": "ومن سورة النور", "d": 0, "pg": 213}, {"i": 28, "t": "ومن سورة الفرقان", "d": 0, "pg": 217}, {"i": 29, "t": "ومن سورة الشعراء", "d": 0, "pg": 221}, {"i": 30, "t": "ومن سورة النمل", "d": 0, "pg": 227}, {"i": 31, "t": "ومن سورة القصص", "d": 0, "pg": 233}, {"i": 32, "t": "ومن سورة العنكبوت", "d": 0, "pg": 237}, {"i": 33, "t": "ومن سورة الروم", "d": 0, "pg": 239}, {"i": 34, "t": "ومن سورة لقمان", "d": 0, "pg": 241}, {"i": 35, "t": "ومن سورة السجدة", "d": 0, "pg": 243}, {"i": 36, "t": "ومن سورة الأحزاب", "d": 0, "pg": 245}, {"i": 37, "t": "ومن سورة سبأ", "d": 0, "pg": 249}, {"i": 38, "t": "ومن سورة فاطر", "d": 0, "pg": 253}, {"i": 39, "t": "صفحة فارغة", "d": 0, "pg": 256}, {"i": 40, "t": "ومن سورة يس", "d": 0, "pg": 257}, {"i": 41, "t": "صفحة فارغة", "d": 0, "pg": 260}, {"i": 42, "t": "ومن سورة الصافات", "d": 0, "pg": 261}, {"i": 43, "t": "صفحة فارغة", "d": 0, "pg": 270}, {"i": 44, "t": "ومن سورة ص", "d": 0, "pg": 271}, {"i": 45, "t": "ومن سورة الزمر", "d": 0, "pg": 279}, {"i": 46, "t": "ومن سورة المؤمن", "d": 0, "pg": 285}, {"i": 47, "t": "وقابل التوب جمع توبة والتوب مصدر تاب ذي الطول أي الغنى والفضل ينادون لمقت الله أكبر المقت البغض", "d": 0, "pg": 285}, {"i": 48, "t": "ومن سورة السجدة", "d": 0, "pg": 289}, {"i": 49, "t": "غير ممنون أي غير مقطوع وغير ممنون أي لا يمن عليهم قضاهن أي فخلقهن ريحا صرصرا أي باردة", "d": 0, "pg": 289}, {"i": 50, "t": "ومن سورة حم عسق", "d": 0, "pg": 293}, {"i": 51, "t": "شرعوا لهم أي أظهروا لهم ومن يقترف حسنة قال الاقتراف الاكتساب يكون خيرا ويكون شرا أو يزوجهم أي يقرنهم", "d": 0, "pg": 293}, {"i": 52, "t": "ومن سورة الزخرف", "d": 0, "pg": 295}, {"i": 53, "t": "ومن سورة الدخان", "d": 0, "pg": 299}, {"i": 54, "t": "ومن سورة الجاثية", "d": 0, "pg": 301}, {"i": 55, "t": "ومن سورة الأحقاف", "d": 0, "pg": 303}, {"i": 56, "t": "ومن سورة محمد عليه السلام", "d": 0, "pg": 305}, {"i": 57, "t": "ومن سورة الفتح", "d": 0, "pg": 307}, {"i": 58, "t": "ومن سورة الحجرات", "d": 0, "pg": 311}, {"i": 59, "t": "أومن سورة ق", "d": 0, "pg": 313}, {"i": 60, "t": "ومن سورة والذاريات", "d": 0, "pg": 317}, {"i": 61, "t": "ومن سورة والطور", "d": 0, "pg": 321}, {"i": 62, "t": "ومن سورة والنجم", "d": 0, "pg": 325}, {"i": 63, "t": "ومن سورة اقتربت", "d": 0, "pg": 329}, {"i": 64, "t": "اقتربت الساعة وانشق القمر قال ثعلب هذا مقدم ومؤخر لأن القمر قد انشق وكانت إحدى آيات النبوة قال وقال ابن مسعود وحذيفة ولقد رأيناه وقد صار نصفه على جبل ونصفه على جبل آخر", "d": 0, "pg": 329}, {"i": 65, "t": "ومن سورة الرحمن تعالى", "d": 0, "pg": 333}, {"i": 66, "t": "ومن سورة الواقعة", "d": 0, "pg": 337}, {"i": 67, "t": "ومن سورة الحديد", "d": 0, "pg": 341}, {"i": 68, "t": "ومن سورة المجادلة", "d": 0, "pg": 343}, {"i": 69, "t": "ومن سورة الحشر", "d": 0, "pg": 345}, {"i": 70, "t": "ومن سورة الممتحنة", "d": 0, "pg": 347}, {"i": 71, "t": "ومن سورة الصف", "d": 0, "pg": 349}, {"i": 72, "t": "ومن سورة الجمعة", "d": 0, "pg": 351}, {"i": 73, "t": "ومن سورة المنافقون", "d": 0, "pg": 353}, {"i": 74, "t": "ومن سورة التغابن والطلاق", "d": 0, "pg": 355}, {"i": 75, "t": "ومن سورة التحريم", "d": 0, "pg": 357}, {"i": 76, "t": "ومن سورة الملك", "d": 0, "pg": 359}, {"i": 77, "t": "ومن سورة ن", "d": 0, "pg": 361}, {"i": 78, "t": "قال أوسطهم أي أفضلهم وخيرهم", "d": 0, "pg": 361}, {"i": 79, "t": "ومن سورة الحاقة", "d": 0, "pg": 363}, {"i": 80, "t": "ومن سورة سأل سائل", "d": 0, "pg": 365}, {"i": 81, "t": "بعذاب واقع أي عن عذاب واقع للشوى أي جلدة الرأس جمع شواة والشوى اليدان والرجلان", "d": 0, "pg": 365}, {"i": 82, "t": "ومن سورة نوح عليه السلام", "d": 0, "pg": 369}, {"i": 83, "t": "ومن سورة قل أوحي", "d": 0, "pg": 371}, {"i": 84, "t": "طرائق قددا الطرائق الجماعات والقدد الفرق واحدتها قدة وأنه لما قام عبد الله يعني محمدا صلى الله عليه وسلم", "d": 0, "pg": 371}, {"i": 85, "t": "ومن سورة المزمل", "d": 0, "pg": 373}, {"i": 86, "t": "ومن سورة المدثر عليه السلام", "d": 0, "pg": 377}, {"i": 87, "t": "ومن سورة القيامة", "d": 0, "pg": 379}, {"i": 88, "t": "ومن سورة هل أتى على الإنسان", "d": 0, "pg": 383}, {"i": 89, "t": "هل أتى أي قد أتى مخلدون أي مقرطون بالخلدة ووجمعها خلد وهي القرطة ومخلدون أي لا يشيبون أي كلهم شباب مرد", "d": 0, "pg": 383}, {"i": 90, "t": "ومن سورة المرسلات", "d": 0, "pg": 385}, {"i": 91, "t": "ومن سورة عم يتساءلون", "d": 0, "pg": 387}, {"i": 92, "t": "سباتا أي قطعا والسبت القطع فكأنه إذا نام فقد انقطع عن الناس أفواجا أي جماعات واحدها فوج", "d": 0, "pg": 387}, {"i": 93, "t": "ومن سورة والنازعات", "d": 0, "pg": 389}, {"i": 94, "t": "ومن سورة عبس", "d": 0, "pg": 391}, {"i": 95, "t": "ومن سورة كورت", "d": 0, "pg": 393}, {"i": 96, "t": "كورت أي جمعت وإذا النجوم انكدرت أي تناثرت", "d": 0, "pg": 393}, {"i": 97, "t": "ومن سورة انفطرت", "d": 0, "pg": 395}, {"i": 98, "t": "فعدلك أي قومك وفعدلك أي صرفك من الكفر إلى الإيمان وهما نعمتان", "d": 0, "pg": 395}, {"i": 99, "t": "ومن سورة المطففين", "d": 0, "pg": 397}, {"i": 100, "t": "ومن سورة إذا السماء انشقت", "d": 0, "pg": 399}, {"i": 101, "t": "وأذنت أي استمعت وحقت أي وحق لها أن تسمع كلام خالقها كادح إلى ربك كدحا أي عامل عملا خيرا أو شرا", "d": 0, "pg": 399}, {"i": 102, "t": "ومن سورة البروج", "d": 0, "pg": 401}, {"i": 103, "t": "ومن سورة الطارق", "d": 0, "pg": 403}, {"i": 104, "t": "ومن سورة الأعلى", "d": 0, "pg": 407}, {"i": 105, "t": "ومن سورة الغاشية", "d": 0, "pg": 409}, {"i": 106, "t": "ومن سورة الفجر", "d": 0, "pg": 411}, {"i": 107, "t": "ومن سورة لا أقسم البلد", "d": 0, "pg": 413}, {"i": 108, "t": "ومن سورة والشمس وضحاها", "d": 0, "pg": 415}, {"i": 109, "t": "ومن سورة الليل", "d": 0, "pg": 417}, {"i": 110, "t": "ومن سورة والضحى", "d": 0, "pg": 419}, {"i": 111, "t": "ومن سورة الشرح والتين والعلق والقدر", "d": 0, "pg": 421}, {"i": 112, "t": "ومن سورة لم يكن البينة", "d": 0, "pg": 423}, {"i": 113, "t": "ومن سورة الزلزلة", "d": 0, "pg": 425}, {"i": 114, "t": "ومن سورة والعاديات", "d": 0, "pg": 427}, {"i": 115, "t": "ومن سورة القارعة والتكاثر والعصر والهمزة والفيل", "d": 0, "pg": 429}, {"i": 116, "t": "ومن سورة لايلاف قريش", "d": 0, "pg": 431}, {"i": 117, "t": "ومن سورة أرأيت الماعون", "d": 0, "pg": 433}, {"i": 118, "t": "ومن سورة الكوثر", "d": 0, "pg": 435}, {"i": 119, "t": "ومن سورة قل يا أيها الكافرون", "d": 0, "pg": 437}, {"i": 120, "t": "ومن سورة النصر", "d": 0, "pg": 439}, {"i": 121, "t": "ومن سورة تبت المسد", "d": 0, "pg": 441}, {"i": 122, "t": "ومن سورة الإخلاص", "d": 0, "pg": 443}, {"i": 123, "t": "ومن سورة الفلق", "d": 0, "pg": 445}, {"i": 124, "t": "ومن سورة الناس", "d": 0, "pg": 449}]}