{"id": 6087, "slug": "تأويل-مشكل-القرآن", "title": "تأويل مشكل القرآن", "author": "ابن قتيبة", "death": "276", "toc": [{"i": 0, "t": "الحكاية عن الطاعنين", "d": 1, "pg": 22}, {"i": 1, "t": "تقديم", "d": 0, "pg": 22}, {"i": 2, "t": "ترجمة ابن قتيبة الدينوري", "d": 0, "pg": 22}, {"i": 3, "t": "مؤلفات ابن قتيبة", "d": 0, "pg": 22}, {"i": 4, "t": "مقدمه المؤلف", "d": 0, "pg": 22}, {"i": 5, "t": "باب ذكر العرب وما خصهم الله به من العارضة والبيان واتساع المجاز", "d": 0, "pg": 22}, {"i": 6, "t": "وقد تدبرت وجوه الخلاف في القراءات فوجدتها سبعة أوجه", "d": 1, "pg": 29}, {"i": 7, "t": "باب الرد عليهم في وجوه القراءات", "d": 0, "pg": 29}, {"i": 8, "t": "باب ما ادعي على القرآن من اللحن", "d": 1, "pg": 34}, {"i": 9, "t": "باب الكناية والتعريض", "d": 0, "pg": 158}, {"i": 10, "t": "الكناية أنواع، ولها مواضع", "d": 1, "pg": 158}, {"i": 11, "t": "باب التناقض والاختلاف", "d": 0, "pg": 158}, {"i": 12, "t": "باب المتشابه", "d": 0, "pg": 158}, {"i": 13, "t": "باب القول في المجاز", "d": 0, "pg": 158}, {"i": 14, "t": "باب الاستعارة", "d": 0, "pg": 158}, {"i": 15, "t": "باب المقلوب", "d": 0, "pg": 158}, {"i": 16, "t": "باب الحذف والاختصار", "d": 0, "pg": 158}, {"i": 17, "t": "باب تكرار الكلام والزيادة فيه", "d": 0, "pg": 158}, {"i": 18, "t": "ومن هذا الباب (التعريض) .", "d": 1, "pg": 161}, {"i": 19, "t": "باب مخالفة ظاهر اللفظ معناه", "d": 0, "pg": 168}, {"i": 20, "t": "من ذلك الدعاء على جهة الذم لا يراد به الوقوع:", "d": 1, "pg": 168}, {"i": 21, "t": "ومن ذلك الجزاء عن الفعل بمثل لفظه والمعنيان مختلفان:", "d": 1, "pg": 169}, {"i": 22, "t": "ومنه أن يأتي الكلام على مذهب الاستفهام وهو تقرير:", "d": 1, "pg": 169}, {"i": 23, "t": "ومنه أن يأتي على مذهب الاستفهام وهو تعجب:", "d": 1, "pg": 169}, {"i": 24, "t": "وأن يأتي على مذهب الاستفهام وهو توبيخ:", "d": 1, "pg": 170}, {"i": 25, "t": "ومنه أن يأتي الكلام على لفظ الأمر وهو تهديد:", "d": 1, "pg": 170}, {"i": 26, "t": "وأن يأتي على لفظ الأمر وهو تأديب:", "d": 1, "pg": 170}, {"i": 27, "t": "وعلى لفظ الأمر وهو إباحة:", "d": 1, "pg": 170}, {"i": 28, "t": "وعلى لفظ الأمر وهو فرض:", "d": 1, "pg": 170}, {"i": 29, "t": "ومنه عام يراد به خاص:", "d": 1, "pg": 170}, {"i": 30, "t": "ومنه جمع يراد به واحد واثنان:", "d": 1, "pg": 171}, {"i": 31, "t": "ومنه واحد يراد به جميع:", "d": 1, "pg": 171}, {"i": 32, "t": "ومنه أن تصف الجميع صفة الواحد:", "d": 1, "pg": 172}, {"i": 33, "t": "ومنه أن يوصف الواحد بالجمع:", "d": 1, "pg": 173}, {"i": 34, "t": "ومنه أن يجتمع شيئان ولأحدهما فعل فيجعل الفعل لهما:", "d": 1, "pg": 173}, {"i": 35, "t": "ومنه أن يجتمع شيئان فيجعل الفعل لأحدهما، أو تنسبه إلى أحدهما وهو لهما:", "d": 1, "pg": 174}, {"i": 36, "t": "ومنه أن تخاطب الشاهد بشيء ثم تجعل الخطاب له على لفظ الغائب:", "d": 1, "pg": 175}, {"i": 37, "t": "ومنه أن يخاطب الرجل بشيء ثم يجعل الخطاب لغيره:", "d": 1, "pg": 175}, {"i": 38, "t": "ومنه أن تأمر الواحد والاثنين والثلاثة فما فوق أمرك الاثنين: فتقول:", "d": 1, "pg": 176}, {"i": 39, "t": "ومنه أن يخاطب الواحد بلفظ الجميع:", "d": 1, "pg": 177}, {"i": 40, "t": "ومنه أن يأتي الفعل على بنية الماضي وهو دائم، أو مستقبل:", "d": 1, "pg": 178}, {"i": 41, "t": "ومنه أن يجيء المفعول به على لفظ الفاعل:", "d": 1, "pg": 178}, {"i": 42, "t": "وأن يأتي فعيل بمعنى مفعل:", "d": 1, "pg": 179}, {"i": 43, "t": "وفعيل، يراد به فاعل:", "d": 1, "pg": 179}, {"i": 44, "t": "ومنه أن يأتي الفاعل على لفظ المفعول به، وهو قليل:", "d": 1, "pg": 179}, {"i": 45, "t": "في سورة سبأ", "d": 1, "pg": 188}, {"i": 46, "t": "وعلم الله تعالى نوعان:", "d": 0, "pg": 188}, {"i": 47, "t": "أحدهما علم ما يكون من إيمان المؤمنين، وكفر الكافرين، وذنوب العاصين، وطاعات المطيعين قبل أن تكون.", "d": 0, "pg": 188}, {"i": 48, "t": "والآخر: علم هذه الأمور ظاهرة موجودة فيحق القول ويقع بوقوعها الجزاء.", "d": 0, "pg": 188}, {"i": 49, "t": "باب تأويل الحروف التي ادعى على القرآن بها الاستحالة وفساد النظم", "d": 0, "pg": 188}, {"i": 50, "t": "في سورة الفرقان", "d": 1, "pg": 189}, {"i": 51, "t": "في سورة يس", "d": 1, "pg": 190}, {"i": 52, "t": "في سورة المرسلات", "d": 1, "pg": 191}, {"i": 53, "t": "في سورة الأنعام", "d": 1, "pg": 192}, {"i": 54, "t":