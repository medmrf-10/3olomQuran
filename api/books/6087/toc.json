{"id": 6087, "slug": "تأويل-مشكل-القرآن", "title": "تأويل مشكل القرآن", "author": "ابن قتيبة", "death": "276", "toc": [{"i": 0, "t": "الحكاية عن الطاعنين", "d": 1, "pg": 24, "j": null, "sz": 11020}, {"i": 1, "t": "تقديم", "d": 0, "pg": 24, "j": null, "sz": 1407}, {"i": 2, "t": "ترجمة ابن قتيبة الدينوري", "d": 0, "pg": 24, "j": null, "sz": 1407}, {"i": 3, "t": "مؤلفات ابن قتيبة", "d": 0, "pg": 24, "j": null, "sz": 1407}, {"i": 4, "t": "مقدمه المؤلف", "d": 0, "pg": 24, "j": null, "sz": 1407}, {"i": 5, "t": "باب ذكر العرب وما خصهم الله به من العارضة والبيان واتساع المجاز", "d": 0, "pg": 24, "j": null, "sz": 1407}, {"i": 6, "t": "وقد تدبرت وجوه الخلاف في القراءات فوجدتها سبعة أوجه", "d": 1, "pg": 31, "j": null, "sz": 7597}, {"i": 7, "t": "باب الرد عليهم في وجوه القراءات", "d": 0, "pg": 31, "j": null, "sz": 1339}, {"i": 8, "t": "باب ما ادعي على القرآن من اللحن", "d": 1, "pg": 36, "j": null, "sz": 131934}, {"i": 9, "t": "باب الكناية والتعريض", "d": 0, "pg": 160, "j": null, "sz": 64}, {"i": 10, "t": "الكناية أنواع، ولها مواضع", "d": 1, "pg": 160, "j": null, "sz": 5500}, {"i": 11, "t": "باب التناقض والاختلاف", "d": 0, "pg": 160, "j": null, "sz": 1209}, {"i": 12, "t": "باب المتشابه", "d": 0, "pg": 160, "j": null, "sz": 1209}, {"i": 13, "t": "باب القول في المجاز", "d": 0, "pg": 160, "j": null, "sz": 1209}, {"i": 14, "t": "باب الاستعارة", "d": 0, "pg": 160, "j": null, "sz": 1209}, {"i": 15, "t": "باب المقلوب", "d": 0, "pg": 160, "j": null, "sz": 1209}, {"i": 16, "t": "باب الحذف والاختصار", "d": 0, "pg": 160, "j": null, "sz": 1209}, {"i": 17, "t": "باب تكرار الكلام والزيادة فيه", "d": 0, "pg": 160, "j": null, "sz": 1209}, {"i": 18, "t": "ومن هذا الباب (التعريض) .", "d": 1, "pg": 163, "j": null, "sz": 6762}, {"i": 19, "t": "باب مخالفة ظاهر اللفظ معناه", "d": 0, "pg": 170, "j": null, "sz": 70}, {"i": 20, "t": "من ذلك الدعاء على جهة الذم لا يراد به الوقوع:", "d": 1, "pg": 170, "j": null, "sz": 798}, {"i": 21, "t": "ومن ذلك الجزاء عن الفعل بمثل لفظه والمعنيان مختلفان:", "d": 1, "pg": 171, "j": null, "sz": 792}, {"i": 22, "t": "ومنه أن يأتي الكلام على مذهب الاستفهام وهو تقرير:", "d": 1, "pg": 171, "j": null, "sz": 375}, {"i": 23, "t": "ومنه أن يأتي على مذهب الاستفهام وهو تعجب:", "d": 1, "pg": 171, "j": null, "sz": 344}, {"i": 24, "t": "وأن يأتي على مذهب الاستفهام وهو توبيخ:", "d": 1, "pg": 172, "j": null, "sz": 153}, {"i": 25, "t": "ومنه أن يأتي الكلام على لفظ الأمر وهو تهديد:", "d": 1, "pg": 172, "j": null, "sz": 129}, {"i": 26, "t": "وأن يأتي على لفظ الأمر وهو تأديب:", "d": 1, "pg": 172, "j": null, "sz": 196}, {"i": 27, "t": "وعلى لفظ الأمر وهو إباحة:", "d": 1, "pg": 172, "j": null, "sz": 204}, {"i": 28, "t": "وعلى لفظ الأمر وهو فرض:", "d": 1, "pg": 172, "j": null, "sz": 180}, {"i": 29, "t": "ومنه عام يراد به خاص:", "d": 1, "pg": 172, "j": null, "sz": 1360}, {"i": 30, "t": "ومنه جمع يراد به واحد واثنان:", "d": 1, "pg": 173, "j": null, "sz": 1018}, {"i": 31, "t": "ومنه واحد يراد به جميع:", "d": 1, "pg": 173, "j": null, "sz": 737}, {"i": 32, "t": "ومنه أن تصف الجميع صفة الواحد:", "d": 1, "pg": 174, "j": null, "sz": 364}, {"i": 33, "t": "ومنه أن يوصف الواحد بالجمع:", "d": 1, "pg": 175, "j": null, "sz": 179}, {"i": 34, "t": "ومنه أن يجتمع شيئان ولأحدهما فعل فيجعل الفعل لهما:", "d": 1, "pg": 175, "j": null, "sz": 945}, {"i": 35, "t": "ومنه أن يجتمع شيئان فيجعل الفعل لأحدهما، أو تنسبه إلى أحدهما وهو لهما:", "d": 1, "pg": 176, "j": null, "sz": 604}, {"i": 36, "t": "ومنه أن تخاطب الشاهد بشيء ثم تجعل الخطاب له على لفظ الغائب:", "d": 1, "pg": 177, "j": null, "sz": 744}, {"i": 37, "t": "ومنه أن يخاطب الرجل بشيء ثم يجعل الخطاب لغيره:", "d": 1, "pg": 177, "j": null, "sz": 656}, {"i": 38, "t": "ومنه أن تأمر الواحد والاثنين والثلاثة فما فوق أمرك الاثنين: فتقول:", "d": 1, "pg": 178, "j": null, "sz": 901}, {"i": 39, "t": "ومنه أن يخاطب الواحد بلفظ الجميع:", "d": 1, "pg": 179, "j": null, "sz": 1376}, {"i": 40, "t": "ومنه أن يأتي الفعل على بنية الماضي وهو دائم، أو مستقبل:", "d": 1, "pg": 180, "j": null, "sz": 985}, {"i": 41, "t": "ومنه أن يجيء المفعول به على لفظ الفاعل:", "d": 1, "pg": 180, "j": null, "sz": 603}, {"i": 42, "t": "وأن يأتي فعيل بمعنى مفعل:", "d": 1, "pg": 181, "j": null, "sz": 282}, {"i": 43, "t": "وفعيل، يراد به فاعل:", "d": 1, "pg": 181, "j": null, "sz": 286}, {"i": 44, "t": "ومنه أن يأتي الفاعل على لفظ المفعول به، وهو قليل:", "d": 1, "pg": 181, "j": null, "sz": 7171}, {"i": 45, "t": "في سورة سبأ", "d": 1, "pg": 190, "j": null, "sz": 668}, {"i": 46, "t": "وعلم الله تعالى نوعان:", "d": 0, "pg": 190, "j": null, "sz": 65}, {"i": 47, "t": "أحدهما علم ما يكون من إيمان المؤمنين، وكفر الكافرين، وذنوب العاصين، وطاعات المطيعين قبل أن تكون.", "d": 0, "pg": 190, "j": null, "sz": 192}, {"i": 48, "t": "والآخر: علم هذه الأمور ظاهرة موجودة فيحق القول ويقع بوقوعها الجزاء.", "d": 0, "pg": 190, "j": null, "sz": 1162}, {"i": 49, "t": "باب تأويل الحروف التي ادعى على القرآن بها الاستحالة وفساد النظم", "d": 0, "pg": 190, "j": null, "sz": 109}, {"i": 50, "t": "في سورة الفرقان", "d": 1, "pg": 191, "j": null, "sz": 1508}, {"i": 51, "t": "في سورة يس", "d": 1, "pg": 192, "j": null, "sz": 1901}, {"i": 52, "t": "في سورة المرسلات", "d": 1, "pg": 193, "j": null, "sz": 1842}, {"i": 53, "t": "في سورة الأنعام", "d": 1, "pg": 194, "j": null, "sz": 447}, {"i": 54, "t": "في سورة النساء", "d": 1, "pg": 195, "j": null, "sz": 1166}, {"i": 55, "t": "في سورة البقرة", "d": 1, "pg": 195, "j": null, "sz": 1613}, {"i": 56, "t": "في سورة الرعد", "d": 1, "pg": 196, "j": null, "sz": 1134}, {"i": 57, "t": "في سورة النور", "d": 1, "pg": 197, "j": null, "sz": 3302}, {"i": 58, "t": "في سورة سبأ", "d": 1, "pg": 198, "j": null, "sz": 1657}, {"i": 59, "t": "في سورة النور", "d": 1, "pg": 199, "j": null, "sz": 2941}, {"i": 60, "t": "في سورة الأنعام", "d": 1, "pg": 201, "j": null, "sz": 3909}, {"i": 61, "t": "في سورة الأنعام", "d": 1, "pg": 203, "j": null, "sz": 2340}, {"i": 62, "t": "في سورة التين", "d": 1, "pg": 204, "j": null, "sz": 1488}, {"i": 63, "t": "في سورة والشمس وضحاها", "d": 1, "pg": 205, "j": null, "sz": 1490}, {"i": 64, "t": "في لا أقسم بيوم القيام