ف والريحان (١٢)", "d": 1, "pg": 183, "j": null, "sz": 600}, {"i": 126, "t": "تتميم", "d": 1, "pg": 184, "j": null, "sz": 682}, {"i": 127, "t": "(وحور عين (٢٢) .", "d": 1, "pg": 185, "j": null, "sz": 157}, {"i": 128, "t": "حرف الواو", "d": 0, "pg": 186, "j": null, "sz": 91}, {"i": 129, "t": "(اشتروا الضلالة بالهدى)", "d": 1, "pg": 186, "j": null, "sz": 639}, {"i": 130, "t": "(فتمنوا الموت إن كنتم صادقين (٩٤)", "d": 1, "pg": 187, "j": null, "sz": 459}, {"i": 131, "t": "تنبيه", "d": 1, "pg": 187, "j": null, "sz": 393}, {"i": 132, "t": "(لو استطعنا لخرجنا معكم)", "d": 1, "pg": 188, "j": null, "sz": 420}, {"i": 133, "t": "(سيجعل لهم الرحمن ودا (٩٦)", "d": 1, "pg": 188, "j": null, "sz": 270}, {"i": 134, "t": "تتميم", "d": 1, "pg": 188, "j": null, "sz": 905}, {"i": 135, "t": "(فتمنوا الموت إن كنتم صادقين (٦)", "d": 1, "pg": 190, "j": null, "sz": 364}, {"i": 136, "t": "(من وجدكم)", "d": 1, "pg": 190, "j": null, "sz": 225}, {"i": 137, "t": "حرف الهاء", "d": 0, "pg": 191, "j": null, "sz": 89}, {"i": 138, "t": "(وهن العظم مني)", "d": 1, "pg": 191, "j": null, "sz": 235}, {"i": 139, "t": "تتميم", "d": 1, "pg": 191, "j": null, "sz": 523}, {"i": 140, "t": "حرف الياء", "d": 0, "pg": 192, "j": null, "sz": 93}, {"i": 141, "t": "(إن أولى الناس بإبراهيم للذين اتبعوه وهذا النبي)", "d": 1, "pg": 192, "j": null, "sz": 912}, {"i": 142, "t": "تتميم", "d": 1, "pg": 193, "j": null, "sz": 296}, {"i": 143, "t": "(وصدوكم عن المسجد الحرام والهدي)", "d": 1, "pg": 193, "j": null, "sz": 536}, {"i": 144, "t": "تتميم", "d": 1, "pg": 194, "j": null, "sz": 1958}]}